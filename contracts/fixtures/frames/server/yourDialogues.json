        {
          "id": "arrives",
          "speaker": "messenger",
          "words": "Agnes, a rider has come in from the coast with a letter under the harbour-master's seal.",
          "effects": []
        },
        {
          "id": "reads",
          "speaker": "messenger",
          "words": "The harbour-master is building a new quay, and asks whether the house will stand behind it.",
          "effects": []
        },
        {
          "id": "accept",
          "speaker": "figure",
          "words": "Tell him the house will, and send forty for the masons.",
          "effects": [{ "kind": "spend", "resource": "wealth", "amount": 40 }]
        }
      ],
      "next": [
        {
          "id": "paid",
          "speaker": "messenger",
          "words": "He thought you might say so. The first of the dues came with me."
        }
      ],
