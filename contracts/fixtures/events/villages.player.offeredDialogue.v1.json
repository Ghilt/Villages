          "id": "agnes",
          "party": 0,
          "name": "Agnes Hollin",
          "portrait": "woman-03",
          "character": "cb732500-39bd-3b39-a838-bb89f719578f"
        },
        {
          "id": "messenger",
          "party": 1,
          "name": "A messenger",
          "portrait": null,
          "character": null
        }
      ],
      "lines": [
        {
          "id": "arrives",
          "speaker": "messenger",
          "words": "A rider from the coast, my lady, with the harbour-master's seal.",
          "effects": [],
          "recorded": false,
          "then": { "kind": "say", "line": "asks" },
          "revealImpact": null
        },
        {
          "id": "asks",
          "speaker": "messenger",
          "words": "He asks whether the house will stand behind the new quay.",
          "effects": [],
          "recorded": true,
          "then": { "kind": "dialogueChoice", "options": ["accept", "refuse"] },
          "revealImpact": null
        },
        {
          "id": "accept",
          "speaker": "agnes",
          "words": "Tell him it will, and send forty for the masons.",
          "effects": [{ "kind": "spend", "resource": "WEALTH", "amount": 40 }],
          "recorded": false,
          "then": { "kind": "say", "line": "thanks" },
          "revealImpact": {
            "kind": "shown",
            "impacts": [
              { "resource": "WEALTH", "amount": -40 },
              { "resource": "WEALTH", "amount": 100 }
            ]
          }
        },
        {
          "id": "refuse",
          "speaker": "agnes",
          "words": "Tell him the house has quays enough of its own.",
          "effects": [],
          "recorded": false,
          "then": { "kind": "end" },
          "revealImpact": { "kind": "hidden" }
        },
        {
          "id": "thanks",
          "speaker": "messenger",
          "words": "He will be glad of it. The first of the dues came with me.",
          "effects": [{ "kind": "grant", "resource": "WEALTH", "amount": 100 }],
          "recorded": false,
          "then": { "kind": "end" },
          "revealImpact": null
        }
