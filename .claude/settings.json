{
  "permissions": {
    "allow": [
      "Bash(git commit:*)",
      "Bash(git rebase:*)"
    ],
    "ask": [
      "Bash(git push:*)",
      "Bash(git tag:*)"
    ],
    "deny": [
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git reset --hard:*)",
      "Bash(git clean:*)"
    ]
  }
}