# Gradle
.gradle/
# The Kotlin Gradle plugin keeps its compiler daemon session files here, in every project that has one.
.kotlin/
# Gradle output. This swallows any directory called build, wherever it is, so do not name a
# source directory that: it will not be committed and nothing will say so.
**/build/
!gradle/wrapper/gradle-wrapper.jar

# JVM
*.class
*.log
hs_err_pid*
# A heap dump, which the Kotlin compile daemon writes beside the build when it runs out of memory: hundreds of
# megabytes, and once nearly committed.
*.hprof

# IDEs
.idea/
*.iml
out/
.vscode/

# Node
node_modules/
dist/
coverage/
playwright-report/
test-results/
.vite/
*.tsbuildinfo

# Raw material for the world generator: downloaded, not ours, and large
world/source/

# Which ports and paths this checkout's servers use. Generated per worktree, because every field in it
# is per-checkout: `node frontend/apps/web/vite/worktreePort.ts --launch` writes it. See decision 0031.
.claude/launch.json

# Where this tree's session stands: its plan's steps and the verification requests waiting on Adam. The
# session's own, replaced whole by its next plan; the plan skill says its shape, the button bar reads it.
.claude/status.json

# Views the painterly renderer paints. Output, reproducible, and tens of megabytes of it.
world/painterly/

# The scenery's stands, which the game server reads and hands a page only as far as its fog lets it see.
# Output, reproducible, and kept out of the page's public folder on purpose. See decision record 0067.
world/stands/

# Each master's ground map, which only the game server reads, to work out what a player is looking at (0084).
world/ground/

# world/master/ is deliberately NOT ignored: the master image is the authored source of truth for
# the shape of the world, and it travels with the repository. See docs/AUTHORING-THE-WORLD.md.
#
# The importer writes a small preview beside every master it reads, so a folder of candidates would
# otherwise fill the status output with generated images. The one for the world we actually play on
# travels with it; the rest are output.
world/master/*-preview.png
!world/master/terrain-preview.png

# The generated world: reproducible from world/warp.json, and it would bloat the history
frontend/apps/web/public/world/

# What the two servers printed while debug-quick-start ran them. Machine-local and rewritten on
# every start.
.logs/

# Environment
.env
.env.*
!.env.example

# OS
Thumbs.db
.DS_Store

# Claude Code local overrides
.claude/settings.local.json

# What each live session is doing. Machine-local by design: a file every session edited would be the
# merge conflict it exists to prevent. The convention itself is committed.
.sessions/*
!.sessions/README.md

# The development world's saves, made from the debug panel and every tree's, beside the shared .git. A save is a
# world somebody was trying something in, not part of the project. See decision record 0101.
.saves/

# The cut sprites: an atlas and its frames, rebuilt from world/sprites/ by npm run world:art. Output.
frontend/apps/web/public/art/

# The cut interface pictures, each at 1x, 2x and 3x, rebuilt from world/ui/ by npm run world:ui. Output.
frontend/apps/web/public/ui/
