{
  "name": "@villages/world",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./build": "./src/build.ts",
    "./testing": "./src/testing.ts"
  },
  "scripts": {
    "fetch": "node bin/fetchSource.ts",
    "build": "node bin/buildWorld.ts",
    "master": "node --max-old-space-size=8192 bin/buildMaster.ts",
    "import": "node --max-old-space-size=8192 bin/importMaster.ts",
    "merge": "node --max-old-space-size=8192 bin/mergeMaster.ts",
    "tile": "node --max-old-space-size=8192 bin/tileWorld.ts",
    "sprites": "node --max-old-space-size=8192 bin/generateSpriteMap.ts",
    "flow": "node --max-old-space-size=8192 bin/flowWorld.ts",
    "ground": "node --max-old-space-size=8192 bin/groundWorld.ts",
    "origin": "node --max-old-space-size=8192 bin/originWorld.ts",
    "names": "node --max-old-space-size=4096 bin/namesWorld.ts",
    "culture": "node --max-old-space-size=4096 bin/cultureWorld.ts",
    "structures": "node bin/cutStructures.ts",
    "height": "node bin/fetchWorld.ts --only etopo && node --max-old-space-size=8192 bin/heightWorld.ts",
    "paint": "node --max-old-space-size=8192 bin/renderPainterly.ts",
    "fetch-world": "node --max-old-space-size=4096 bin/fetchWorld.ts",
    "scenery": "node --max-old-space-size=8192 bin/renderScenery.ts",
    "portraits": "node bin/drawPortraits.ts",
    "scenes": "node bin/drawScenes.ts",
    "art": "node bin/cutArt.ts",
    "critters": "node bin/cutCritters.ts",
    "ui": "node bin/cutUi.ts",
    "ready": "node bin/readyWorld.ts",
    "prune": "node bin/pruneWorld.ts"
  },
  "devDependencies": {
    "fflate": "^0.8.3",
    "pngjs": "^7.0.0",
    "shapefile": "^0.6.6",
    "sharp": "^0.34.5"
  }
}
