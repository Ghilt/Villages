{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // @villages/world is consumed as source, and it writes explicit .ts extensions so that its own bin
    // scripts run under Node without a build step.
    "allowImportingTsExtensions": true,
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "types": ["vite/client"]
  },
  "include": ["src"]
}
