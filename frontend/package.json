{
  "name": "villages-frontend",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @villages/web",
    "build": "npm run build --workspace @villages/web",
    "preview": "npm run preview --workspace @villages/web",
    "typecheck": "node tools/typecheck.ts",
    "lint": "eslint . --cache --cache-strategy content --cache-location node_modules/.cache/eslint/",
    "format": "prettier --check . --cache --cache-strategy content",
    "format:write": "prettier --write .",
    "test": "vitest run",
    "e2e": "playwright test -c e2e/playwright.config.ts",
    "check": "npm run typecheck && npm run lint && npm run format && npm run test",
    "perf:shaders": "node perf/shaders.ts",
    "perf:startup": "node perf/startup.ts",
    "perf:zoom": "node perf/zoom.ts",
    "world:fetch": "npm run fetch --workspace @villages/world --",
    "world:build": "npm run build --workspace @villages/world --",
    "world:master": "npm run master --workspace @villages/world --",
    "world:import": "npm run import --workspace @villages/world --",
    "world:tile": "npm run tile --workspace @villages/world --",
    "world:sprites": "npm run sprites --workspace @villages/world --",
    "world:flow": "npm run flow --workspace @villages/world --",
    "world:ground": "npm run ground --workspace @villages/world --",
    "world:origin": "npm run origin --workspace @villages/world --",
    "world:names": "npm run names --workspace @villages/world --",
    "world:culture": "npm run culture --workspace @villages/world --",
    "world:ruins": "npm run ruins --workspace @villages/world --",
    "world:structures": "npm run structures --workspace @villages/world --",
    "world:height": "npm run height --workspace @villages/world --",
    "world:scenery": "npm run scenery --workspace @villages/world --",
    "world:portraits": "npm run portraits --workspace @villages/world --",
    "world:scenes": "npm run scenes --workspace @villages/world --",
    "world:art": "npm run art --workspace @villages/world --",
    "world:critters": "npm run critters --workspace @villages/world --",
    "world:ui": "npm run ui --workspace @villages/world --",
    "world:paint": "npm run paint --workspace @villages/world --",
    "world:fetch-all": "npm run fetch-world --workspace @villages/world --",
    "world:ready": "npm run ready --workspace @villages/world --",
    "world:prune": "npm run prune --workspace @villages/world --"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.64.0",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.9.1",
    "prettier": "^3.9.6",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.69.0",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  }
}
